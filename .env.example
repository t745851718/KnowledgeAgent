# KnowledgeAgent environment template
# Copy this file to .env, then replace every CHANGE_ME value.
# Never commit the real .env file or production credentials.

# -----------------------------------------------------------------------------
# MongoDB
# MONGODB_USERNAME / MONGODB_PASSWORD are also consumed by the bundled local
# Docker Compose file. URL-encode special characters used in MONGODB_URI.
# -----------------------------------------------------------------------------
MONGODB_USERNAME=knowledgeagent
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD
MONGODB_URI=mongodb://knowledgeagent:CHANGE_ME_MONGODB_PASSWORD@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=knowledge_agent

# -----------------------------------------------------------------------------
# MinIO
# A bare host:port uses HTTP when MINIO_SECURE=false.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=knowledgeagent
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
BUCKET_NAME=knowledge-agent
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Zilliz Cloud or a compatible Milvus deployment
# Use a new collection when changing embedding models or dimensions.
# -----------------------------------------------------------------------------
ZILLIZ_URI=CHANGE_ME_ZILLIZ_URI
ZILLIZ_TOKEN=CHANGE_ME_ZILLIZ_TOKEN
ZILLIZ_COLLECTION=knowledge_agent_chunks_vl_v1

# -----------------------------------------------------------------------------
# Alibaba Cloud Model Studio / Bailian
# BAILIAN_API_KEY can be replaced by DASHSCOPE_API_KEY.
# The endpoint must support the OpenAI-compatible Responses API used by chat.
# -----------------------------------------------------------------------------
BAILIAN_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=CHANGE_ME_BAILIAN_API_KEY
# DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
# DASHSCOPE_API_HOST=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3-vl-embedding
SPARSE_EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3.7-text-rerank
CHAT_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# MinerU
# -----------------------------------------------------------------------------
MINERU_API_KEY=CHANGE_ME_MINERU_API_KEY
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL=vlm
MINERU_POLL_INTERVAL=5
MINERU_MAX_WAIT=900
MINERU_OUTPUT_ROOT=.data/mineru
MINERU_LANGUAGE=ch

# -----------------------------------------------------------------------------
# Retrieval and ingestion tuning
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=209715200
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_LIMIT=30
RERANK_LIMIT=6
DENSE_RRF_WEIGHT=1.0
SPARSE_RRF_WEIGHT=1.0
RRF_K=60
PROBE_PAID_DEPENDENCIES=false

# -----------------------------------------------------------------------------
# Web proxy and development identity
# Both FastAPI and Express automatically load the root .env file.
# Set INTERNAL_API_TOKEN to a strong shared value outside local development.
# -----------------------------------------------------------------------------
SERVER_BASE_URL=http://127.0.0.1:8000
WEB_PORT=3001
DEVELOPMENT_OWNER_ID=development-user
INTERNAL_API_TOKEN=
NODE_ENV=development

# -----------------------------------------------------------------------------
# Real integration tests (disabled by default because they call external APIs)
# -----------------------------------------------------------------------------
RUN_MINIO_INTEGRATION=0
RUN_FULL_FLOW=0
# FULL_FLOW_DOCUMENT=/absolute/path/to/document.pdf
FULL_FLOW_TIMEOUT=900
